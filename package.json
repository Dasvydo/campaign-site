{
  "name": "campaign-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DoviLoop Teams campaign landing page at teams.doviloop.dev. English, Danish, Lithuanian.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "fonts": "node scripts/copy-fonts.mjs",
    "mock": "node scripts/mock-webhook.mjs",
    "verify:payload": "node scripts/verify-payload.mjs"
  },
  "dependencies": {
    "posthog-js": "^1.203.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.1.0",
    "@fontsource/playfair-display": "^5.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
